# direnv. Run `direnv allow` once in this directory.
#
# Terragrunt 1.0 defaults to OpenTofu, and that is not interchangeable here:
# the lock files pin providers from registry.terraform.io, so tofu either
# mismatches them or silently rewrites them -- and the provider is already
# cached under that registry, which is what lets terraform init with no network
# at all while the router that provides the network is being rebuilt.
#
# root.hcl sets terraform_binary for this reason, but `run --all` ignores it
# (measured, not assumed), so the environment has to carry it too. Without
# direnv, either export this by hand or pass --tf-path terraform.
export TG_TF_PATH=terraform

# A local mirror of the provider, so `init` needs no network.
#
# This is not a nicety here: rebuilding the router means having no internet at
# exactly the moment Terraform wants to reach registry.terraform.io. The
# provider is the only one this config uses, so 21MB on disk buys an init that
# works with the WAN down.
#
# Populate it from any machine that has the provider already:
#   mkdir -p .plugin-cache && cp -R <somewhere>/.terraform/providers/registry.terraform.io .plugin-cache/
#
# .terraformrc turns that directory into a filesystem_mirror, which is what
# actually removes the network dependency -- the plugin cache alone does not,
# because Terraform still queries the registry for available versions.
export TF_PLUGIN_CACHE_DIR="$PWD/.plugin-cache"
export TF_CLI_CONFIG_FILE="$PWD/.terraformrc"

# Written here rather than committed, because Terraform's CLI config has no
# variables and the mirror path must be absolute -- so a checked-in copy would
# hardcode one machine's home directory into a public repo, and work nowhere
# else.
cat > "$PWD/.terraformrc" <<EOF
provider_installation {
  filesystem_mirror {
    path    = "$PWD/.plugin-cache"
    include = ["registry.terraform.io/terraform-routeros/routeros"]
  }
  direct {
    exclude = ["registry.terraform.io/terraform-routeros/routeros"]
  }
}
EOF
