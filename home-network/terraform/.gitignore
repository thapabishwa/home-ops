# State holds every resource and can contain sensitive values.
*.tfstate
*.tfstate.*
.terraform/
.terragrunt-cache/
crash.log

# 21MB provider binary, mirrored locally so init works with the WAN down.
.plugin-cache/

# Generated per stack by root.hcl. Editing it is pointless -- it is overwritten
# on every terragrunt run.
provider_generated.tf
backend_generated.tf

# Generated by .envrc -- holds an absolute path to this checkout.
.terraformrc

# The values file holds the router password.
credentials.hcl

# DHCP reservations: MAC addresses and the names of people's devices.
leases.hcl
*.tfvars
*.tfvars.json

# .terraform.lock.hcl is deliberately NOT ignored. It pins the provider
# version and its checksums, so a later run cannot silently pick up a
# different provider build than the one this config was validated against.

# Credentials live on the hosts, never here. No .example is kept: a file named
# like a config invites being filled in, which is exactly what happened once.

# Archived state from the pre-terragrunt single-stack layout.
.archive/
