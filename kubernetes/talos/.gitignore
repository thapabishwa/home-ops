# State holds the cluster CA keys, etcd secrets and bootstrap tokens.
*.tfstate
*.tfstate.*
.terraform/
.terragrunt-cache/
crash.log

# Generated by terragrunt on every run.
provider_generated.tf
backend_generated.tf

# The Proxmox API token.
credentials.hcl
*.tfvars
*.tfvars.json

# Written from `terragrunt output` -- admin credentials for the cluster.
talosconfig
kubeconfig

# .terraform.lock.hcl is deliberately NOT ignored: it pins provider builds.
